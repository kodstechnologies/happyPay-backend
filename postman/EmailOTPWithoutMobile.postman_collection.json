              "value": "application/json"
            }
          ],
          "body": "{\n  \"success\": false,\n  \"message\": \"OTP has expired\",\n  \"statusCode\": 400\n}"
        },
        {
          "name": "Error - OTP Not Found",
          "originalRequest": {
            "method": "POST",
