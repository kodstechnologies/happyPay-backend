            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"notfound@example.com\",\n  \"otp\": \"1234\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "status": "Bad Request",
          "code": 400,
          "_postman_previewlanguage": "json",
          "header": [
            {
